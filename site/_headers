# What the browser is told, and who actually tells it.
#
# **This file is not served.** The site runs on nginx behind Cloudflare, and the
# headers below come from `/etc/nginx/snippets/zprivacy-headers.conf` on the
# server. This is the record of what they should be, kept in the repository so
# the intent is reviewable with the pages it protects — and it is written in
# Cloudflare Pages' format because that is where the site began.
#
# Keep the two in step. The one time they drifted, the file was read as the
# truth and a difference was reported as a fault that was not one.
#
# The page promises it reaches no third party; these make the browser hold it to
# that rather than trusting us.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

  # A full year, with includeSubDomains, since the switch at midday on
  # 9 October 2026 — raised on the server first and recorded here after, and
  # measured on the live site the same afternoon:
  #
  #     strict-transport-security: max-age=31536000; includeSubDomains
  #
  # It began at five minutes on purpose. A long HSTS is a promise a browser
  # will hold you to for a year: if a renewal fails or a subdomain is not ready
  # for HTTPS, nobody can reach the site and nothing done on the server
  # shortens it. The condition for raising it was clean renewals for a week and
  # every subdomain certain to stay on HTTPS — beta included, which is settled
  # now that the packages have come down from it.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
